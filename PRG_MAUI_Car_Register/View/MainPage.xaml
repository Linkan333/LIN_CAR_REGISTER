<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PRG_MAUI_Car_Register.ViewModels"
             x:Class="PRG_MAUI_Car_Register.MainPage">

    <ContentPage.BindingContext>
        <vm:VehicleViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Image Source="car.jpg" Aspect="AspectFit" HeightRequest="150" Margin="0,0,0,20"/>

            <HorizontalStackLayout Spacing="20" HorizontalOptions="StartAndExpand">
                <Entry Placeholder="Registreringsnummer"
                       Text="{Binding RegistrationNumber}" />
                <Label Text="Välj typ:" VerticalOptions="Center"/>
                <Picker TextColor="DarkRed"
                        SelectedItem="{Binding SelectedType}">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Bil</x:String>
                            <x:String>MC</x:String>
                            <x:String>Lastbil</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </HorizontalStackLayout>

            <Entry Placeholder="Tillverkare" Text="{Binding Manufacturer}" />
            <Entry Placeholder="Modell" Text="{Binding Model}" />
            <Entry Placeholder="Årsmodell" Keyboard="Numeric" Text="{Binding YearModel}" />

            <Button Text="Registrera"
                    Command="{Binding RegisterCommand}"
                    Margin="0,0,0,20"
                    BackgroundColor="DarkRed"
                    TextColor="White"/>

            <ListView ItemsSource="{Binding Vehicles}"
                      Margin="0,0,0,20">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextCell Text="{Binding Description}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <HorizontalStackLayout HorizontalOptions="FillAndExpand" Spacing="20">
                <Entry Placeholder="Sök på registreringsnummer"
                       Text="{Binding SearchText}"
                       HorizontalOptions="FillAndExpand" />
                <Button Text="Sök"
                        Command="{Binding SearchCommand}"
                        BackgroundColor="DarkRed"
                        TextColor="White"
                        HorizontalOptions="End"/>
            </HorizontalStackLayout>

            <Label Text="{Binding SearchResult}"
                   TextColor="DarkRed"
                   Margin="0,20,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
